<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Snow.Engine\Snow.Engine.csproj" />
    <ProjectReference Include="..\Snow.Abstractions\Snow.Abstractions.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    
    <!-- Global Tool Configuration -->
    <PackAsTool>true</PackAsTool>
    <PackageType>DotnetTool</PackageType>
    <ToolCommandName>sandra</ToolCommandName>
    <PackageId>Sandra.Snow.Cli</PackageId>
    <Version>2.0.0-beta.1</Version>
    <AssemblyVersion>2.0.0.0</AssemblyVersion>
    <FileVersion>2.0.0.0</FileVersion>
    <InformationalVersion>2.0.0-beta.1</InformationalVersion>
    
    <!-- Package Metadata -->
    <Authors>Sandra.Snow Contributors</Authors>
    <Company>Sandra.Snow</Company>
    <Product>Sandra.Snow CLI</Product>
    <Description>Modern static site generator inspired by Jekyll, built with .NET 9. Features live reload, incremental builds, and cross-platform support.</Description>
    <Summary>Modern static site generator with live reload and incremental builds</Summary>
    <PackageProjectUrl>https://github.com/Sandra/Sandra.Snow</PackageProjectUrl>
    <PackageDocumentationFile>docs/README.md</PackageDocumentationFile>
    <RepositoryUrl>https://github.com/Sandra/Sandra.Snow</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReleaseNotes>See CHANGELOG.md for detailed release notes</PackageReleaseNotes>
    
    <!-- Package Tags -->
    <PackageTags>static-site-generator;blog;markdown;jekyll;dotnet;cli;cross-platform</PackageTags>
    
    <!-- Release Configuration -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.0.0-beta4.22272.1" />
    <PackageReference Include="Spectre.Console" Version="0.49.1" />
    <PackageReference Include="Spectre.Console.Extensions.Logging" Version="0.2.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.8" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="9.0.8" />
    <PackageReference Include="Microsoft.Extensions.Configuration.CommandLine" Version="9.0.8" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="9.0.8" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
