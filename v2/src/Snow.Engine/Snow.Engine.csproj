<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Snow.Abstractions\Snow.Abstractions.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    
    <!-- Package Metadata -->
    <PackageId>Sandra.Snow.Engine</PackageId>
    <Version>2.0.0-beta.1</Version>
    <Authors>Sandra.Snow Contributors</Authors>
    <Description>Core static site generation engine for Sandra.Snow v2</Description>
    <PackageProjectUrl>https://github.com/Sandra/Sandra.Snow</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Sandra/Sandra.Snow</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>static-site-generator;engine;markdown;templates</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" Version="0.41.3" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.8" />
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.8" />
  </ItemGroup>

</Project>
